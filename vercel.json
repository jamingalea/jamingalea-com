{
  "headers": [
    {
      "source": "/(.*)\\.mjs",
      "headers": [{ "key": "Content-Type", "value": "application/javascript" }]
    },
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/content.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
